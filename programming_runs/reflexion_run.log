from typing import List

def minPath(grid: List[List[int]], k: int) -> List[int]:
    n = len(grid)
    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]
    
    def dfs(i, j, path):
        if len(path) == k:
            return path
        
        min_path = []
        for dx, dy in directions:
            x, y = i + dx, j + dy
            if 0 <= x < n and 0 <= y < n:
                min_path = min(min_path, dfs(x, y, path + [grid[x][y]])) if min_path else dfs(x, y, path + [grid[x][y]])
        
        return min_path
    
    min_val = float('inf')
    min_path = []
    for i in range(n):
        for j in range(n):
            path = dfs(i, j, [grid[i][j]])
            if path and path < min_path:
                min_path = path
    
    return min_path
