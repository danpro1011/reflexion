def is_multiply_prime(a: int) -> bool:
    def is_prime(n):
        if n < 2:
            return False
        for i in range(2, int(n ** 0.5) + 1):
            if n % i == 0:
                return False
        return True

    def prime_factors(n):
        factors = []
        i = 2
        while i * i <= n:
            if n % i:
                i += 1
            else:
                n //= i
                factors.append(i)
        if n > 1:
            factors.append(n)
        return factors

    factors = prime_factors(a)
    if len(factors) == 3 and all(is_prime(f) for f in factors):
        return True
    return False

