--------------------- GENERATED FUNC BODY ---------------------
def separate_paren_groups(paren_string: str) -> List[str]:
    result = []
    count = 0
    current_group = ''
    
    for char in paren_string:
        if char == '(':
            count += 1
            current_group += char
        elif char == ')':
            count -= 1
            current_group += char
            if count == 0:
                result.append(current_group.replace(' ', ''))
                current_group = ''
    
    return result
